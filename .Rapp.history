head(iris)#
str(iris)#
iris#
summary(iris)
set.seed(111)
ind <- sample(2, nrow(iris), replace=TRUE, prob=c(0.67,#
0.33))
?sample
ind
# Training set has the records of Iris where ind is sampled#
#as 1#
iris.training <- iris[ind==1, ]#
# Test set has the records of Iris where ind is sampled as 2#
iris.test <- iris[ind==2, ]
#see how many records were allocated to the training and#
#test sets.#
nrow(iris.training)#
nrow(iris.test)#
#see how many items are in each group#
length(which(iris.training$Species == "setosa"))#
length(which(iris.training$Species == "versicolor"))#
length(which(iris.training$Species == "virginica"))
ind2 <- sample(2, nrow(iris), replace=TRUE, prob=c(0.8,#
0.2))
ind2
library(rpart)
iris_tree <- rpart(Species ~ Sepal.Length + Sepal.Width,#
data=iris.training, method="class")
iris_tree
plot(iris_tree)#
#Now we just need to add the labels to the tree#
text(iris_tree, cex=0.9, use.n=TRUE, xpd=TRUE)
install.packages("rpart.plot") #install the package#
library("rpart.plot") #install the library#
rpart.plot(iris_tree) #plots the decision tree#
rpart.plot(iris_tree, extra=4) #adding the extra=4 makes it#
#easier to read
#see again how many items are in each group#
length(which(iris.training$Species == "setosa"))#
length(which(iris.training$Species == "versicolor"))#
length(which(iris.training$Species == "virginica"))#
