# Create a data frame containing only one record#
test <- data.frame(4.32, 3.34, 1.32, 0.8)#
# Assign names to each column of the data frame#
tags <- c("Sepal.Length", "Sepal.Width", "Petal.Length",#
"Petal.Width")#
names(test) <- tags#
#see what test looks like so far#
test#
# Add one more record into the data frame#
test[2, ] = c(5.32, 6.34, 4.32, 3.8)#
#see what test looks like now#
test
#test the accuracy of the data we have just set up#
pred <- predict(iris_tree, test, type="class")#
pred#
#test the iris.test data#
pred <- predict(iris_tree, iris.test, type="class")#
pred
pred
table(prediction=pred,true=iris.test$Species)#
#Or you can use#
table(pred,iris.test$Species)
