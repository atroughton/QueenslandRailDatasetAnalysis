df <- read.csv("854d17aa-2d85-49a4-9e3e-ff7c06b596a7.csv", fileEncoding = "UTF-8-BOM")#
#
counts <- table(df$GTFS.Route_short_name)#
counts <- counts[c("T1", "T2", "T3", "T4", "T5", "T6", "EX")]#
#
b <- barplot(counts, main = "Route codes per T-line",#
             xlab = "T-line", ylab = "Number of route codes", ylim = c(0, 65))#
text(b, counts, labels = counts, pos = 3)
t1 <- df[df$GTFS.Route_short_name == "T1", ]#
counts <- sort(table(t1$GTFS.Route_long_name), decreasing = TRUE)#
#
b <- barplot(counts, main = "T1 route codes by destination",#
             ylab = "Number of route codes", ylim = c(0, 28))#
text(b, counts, labels = counts, pos = 3)
